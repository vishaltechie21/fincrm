{
  "name": "fincrm-root",
  "version": "1.0.0",
  "description": "Root configuration for FinCRM project",
  "scripts": {
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
    "start:backend": "npm run dev --prefix backend",
    "start:frontend": "npm run dev --prefix frontend",
    "s": "concurrently \"npm run start:backend\" \"npm run start:frontend\"",
    "check:frontend": "npm run build --prefix frontend",
    "check:backend": "node --check backend/src/server.js",
    "check": "concurrently \"npm run check:frontend\" \"npm run check:backend\"",
    "build": "npm run check"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
